{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "IEP & Thrive design tokens. Three tiers: components consume semantic tokens, semantic tokens alias primitives, light/dark live in $extensions.modes. Authored against docs/product/design-brief-mvp.md. Two rules govern this file: the register is age-respectful rather than infantile, because a nine-year-old who already knows they are behind rejects a preschool palette; and every text pair clears WCAG 2.2 AA, because the shipped amber #D4860B measures 2.91:1 on white and fails even the 3:1 large-text floor.",
  "primitive": {
    "color": {
      "ink": {
        "900": {
          "$value": "#14181C",
          "$type": "color"
        },
        "700": {
          "$value": "#2E353D",
          "$type": "color"
        },
        "500": {
          "$value": "#59636E",
          "$type": "color"
        },
        "300": {
          "$value": "#98A2AD",
          "$type": "color"
        },
        "100": {
          "$value": "#D7DDE3",
          "$type": "color"
        }
      },
      "paper": {
        "50": {
          "$value": "#FAF8F5",
          "$type": "color"
        },
        "100": {
          "$value": "#F1EEE9",
          "$type": "color"
        },
        "white": {
          "$value": "#FFFFFF",
          "$type": "color"
        }
      },
      "night": {
        "900": {
          "$value": "#12171A",
          "$type": "color"
        },
        "800": {
          "$value": "#1B2226",
          "$type": "color"
        },
        "700": {
          "$value": "#2A343A",
          "$type": "color"
        },
        "300": {
          "$value": "#A4B0B6",
          "$type": "color"
        },
        "200": {
          "$value": "#C9D2D6",
          "$type": "color"
        },
        "50": {
          "$value": "#EDF1F3",
          "$type": "color"
        }
      },
      "teal": {
        "600": {
          "$value": "#0E6B72",
          "$type": "color"
        },
        "400": {
          "$value": "#5CC6CF",
          "$type": "color"
        }
      },
      "amber": {
        "700": {
          "$value": "#8A5A08",
          "$type": "color"
        },
        "400": {
          "$value": "#E0A94A",
          "$type": "color"
        }
      },
      "green": {
        "600": {
          "$value": "#1D6E52",
          "$type": "color"
        },
        "400": {
          "$value": "#6FD3AC",
          "$type": "color"
        }
      }
    },
    "space": {
      "1": {
        "$value": "4px",
        "$type": "dimension"
      },
      "2": {
        "$value": "8px",
        "$type": "dimension"
      },
      "4": {
        "$value": "16px",
        "$type": "dimension"
      },
      "6": {
        "$value": "24px",
        "$type": "dimension"
      },
      "8": {
        "$value": "32px",
        "$type": "dimension"
      },
      "12": {
        "$value": "48px",
        "$type": "dimension"
      },
      "16": {
        "$value": "64px",
        "$type": "dimension"
      }
    },
    "radius": {
      "1": {
        "$value": "6px",
        "$type": "dimension"
      },
      "2": {
        "$value": "12px",
        "$type": "dimension"
      },
      "4": {
        "$value": "20px",
        "$type": "dimension"
      },
      "full": {
        "$value": "9999px",
        "$type": "dimension"
      }
    },
    "size": {
      "target": {
        "$value": "56px",
        "$type": "dimension"
      },
      "target-large": {
        "$value": "72px",
        "$type": "dimension",
        "$description": "72px: primary actions and instructional targets."
      }
    },
    "duration": {
      "120": {
        "$value": "120ms",
        "$type": "duration"
      },
      "220": {
        "$value": "220ms",
        "$type": "duration"
      },
      "360": {
        "$value": "360ms",
        "$type": "duration"
      }
    },
    "font": {
      "interface": {
        "$value": "Lexend",
        "$type": "fontFamily"
      },
      "instructional": {
        "$value": "Andika",
        "$type": "fontFamily"
      }
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "primary": {
          "$value": "{primitive.color.paper.50}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.paper.50}",
              "dark": "{primitive.color.night.900}"
            }
          }
        },
        "secondary": {
          "$value": "{primitive.color.paper.100}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.paper.100}",
              "dark": "{primitive.color.night.800}"
            }
          }
        },
        "instructional": {
          "$value": "{primitive.color.paper.white}",
          "$type": "color",
          "$description": "The tracing and word-building canvas. Deliberately the highest-contrast ground in the system; pedagogy outranks aesthetic consistency here.",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.paper.white}",
              "dark": "{primitive.color.night.800}"
            }
          }
        },
        "inverse": {
          "$value": "{primitive.color.ink.900}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.900}",
              "dark": "{primitive.color.night.50}"
            }
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{primitive.color.ink.900}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.900}",
              "dark": "{primitive.color.night.50}"
            }
          }
        },
        "secondary": {
          "$value": "{primitive.color.ink.700}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.700}",
              "dark": "{primitive.color.night.200}"
            }
          }
        },
        "muted": {
          "$value": "{primitive.color.ink.500}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.500}",
              "dark": "{primitive.color.night.300}"
            }
          }
        }
      },
      "glyph": {
        "instructional": {
          "$value": "{primitive.color.ink.900}",
          "$type": "color",
          "$description": "The letterform a child is being taught. Never tinted, never decorative, never below AAA. This is a pedagogical token, not a visual one.",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.900}",
              "dark": "{primitive.color.night.50}"
            }
          }
        },
        "ghost": {
          "$value": "{primitive.color.ink.300}",
          "$type": "color",
          "$description": "Stroke-order guide beneath the trace target.",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.300}",
              "dark": "{primitive.color.night.700}"
            }
          }
        }
      },
      "action": {
        "primary": {
          "$value": "{primitive.color.teal.600}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.teal.600}",
              "dark": "{primitive.color.teal.400}"
            }
          }
        },
        "quiet": {
          "$value": "{primitive.color.ink.500}",
          "$type": "color",
          "$description": "Exit and skip controls: always present, never competing for attention.",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.500}",
              "dark": "{primitive.color.night.300}"
            }
          }
        },
        "primary-text": {
          "$value": "{primitive.color.paper.white}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.paper.white}",
              "dark": "{primitive.color.night.900}"
            }
          }
        }
      },
      "state": {
        "attention": {
          "$value": "{primitive.color.amber.700}",
          "$type": "color",
          "$description": "Replaces the shipped #D4860B, which measured 2.91:1 on white and 2.79:1 on cream.",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.amber.700}",
              "dark": "{primitive.color.amber.400}"
            }
          }
        },
        "mastered": {
          "$value": "{primitive.color.green.600}",
          "$type": "color",
          "$description": "Skill held. Muted on purpose: not a gold star, not a reward.",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.green.600}",
              "dark": "{primitive.color.green.400}"
            }
          }
        }
      },
      "boundary": {
        "default": {
          "$value": "{primitive.color.ink.100}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.100}",
              "dark": "{primitive.color.night.700}"
            }
          }
        },
        "strong": {
          "$value": "{primitive.color.ink.700}",
          "$type": "color",
          "$description": "Elkonin box edges. Must read as a container, not as a form field.",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.ink.700}",
              "dark": "{primitive.color.night.50}"
            }
          }
        },
        "focus": {
          "$value": "{primitive.color.teal.600}",
          "$type": "color",
          "$extensions": {
            "modes": {
              "light": "{primitive.color.teal.600}",
              "dark": "{primitive.color.teal.400}"
            }
          }
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{primitive.font.interface}",
          "fontSize": "34px",
          "lineHeight": "1.15",
          "fontWeight": 600,
          "letterSpacing": "-0.02em"
        },
        "$type": "typography"
      },
      "body": {
        "$value": {
          "fontFamily": "{primitive.font.interface}",
          "fontSize": "17px",
          "lineHeight": "1.6",
          "fontWeight": 400,
          "letterSpacing": "0.01em"
        },
        "$type": "typography"
      },
      "label": {
        "$value": {
          "fontFamily": "{primitive.font.interface}",
          "fontSize": "15px",
          "lineHeight": "1.4",
          "fontWeight": 500,
          "letterSpacing": "0.02em"
        },
        "$type": "typography"
      },
      "grapheme-large": {
        "$value": {
          "fontFamily": "{primitive.font.instructional}",
          "fontSize": "180px",
          "lineHeight": "1",
          "fontWeight": 400,
          "letterSpacing": "0.06em"
        },
        "$type": "typography",
        "$description": "Andika, chosen because SIL designed it for literacy learners: single-storey a and g, unambiguous b/d/p/q. Never substitute the interface face here."
      },
      "grapheme-tile": {
        "$value": {
          "fontFamily": "{primitive.font.instructional}",
          "fontSize": "40px",
          "lineHeight": "1",
          "fontWeight": 400,
          "letterSpacing": "0.04em"
        },
        "$type": "typography"
      },
      "word": {
        "$value": {
          "fontFamily": "{primitive.font.instructional}",
          "fontSize": "48px",
          "lineHeight": "1.25",
          "fontWeight": 400,
          "letterSpacing": "0.08em"
        },
        "$type": "typography",
        "$description": "Generous tracking: letter crowding measurably impairs decoding for this population."
      }
    },
    "radius": {
      "control": {
        "$value": "{primitive.radius.4}",
        "$type": "dimension"
      },
      "canvas": {
        "$value": "{primitive.radius.2}",
        "$type": "dimension"
      },
      "tile": {
        "$value": "{primitive.radius.2}",
        "$type": "dimension"
      },
      "box": {
        "$value": "{primitive.radius.1}",
        "$type": "dimension"
      }
    },
    "size": {
      "target": {
        "$value": "{primitive.size.target}",
        "$type": "dimension",
        "$description": "Minimum tap target. Sized for a child's thumb, one-handed, portrait."
      },
      "target-large": {
        "$value": "{primitive.size.target-large}",
        "$type": "dimension",
        "$description": "Primary actions and anything an instructional surface depends on."
      }
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": {
          "$value": "{semantic.color.action.primary}",
          "$type": "color"
        },
        "label": {
          "$value": "{semantic.color.action.primary-text}",
          "$type": "color"
        },
        "radius": {
          "$value": "{semantic.radius.control}",
          "$type": "dimension"
        },
        "min-height": {
          "$value": "{semantic.size.target-large}",
          "$type": "dimension"
        }
      },
      "quiet": {
        "label": {
          "$value": "{semantic.color.action.quiet}",
          "$type": "color"
        },
        "min-height": {
          "$value": "{semantic.size.target}",
          "$type": "dimension"
        }
      }
    },
    "canvas": {
      "trace": {
        "background": {
          "$value": "{semantic.color.surface.instructional}",
          "$type": "color"
        },
        "glyph": {
          "$value": "{semantic.color.glyph.instructional}",
          "$type": "color"
        },
        "ghost": {
          "$value": "{semantic.color.glyph.ghost}",
          "$type": "color"
        },
        "radius": {
          "$value": "{semantic.radius.canvas}",
          "$type": "dimension"
        }
      }
    },
    "elkonin-box": {
      "background": {
        "$value": "{semantic.color.surface.instructional}",
        "$type": "color"
      },
      "border": {
        "$value": "{semantic.color.boundary.strong}",
        "$type": "color"
      },
      "radius": {
        "$value": "{semantic.radius.box}",
        "$type": "dimension"
      },
      "min-height": {
        "$value": "{semantic.size.target-large}",
        "$type": "dimension"
      }
    },
    "grapheme-tile": {
      "background": {
        "$value": "{semantic.color.surface.secondary}",
        "$type": "color"
      },
      "label": {
        "$value": "{semantic.color.glyph.instructional}",
        "$type": "color"
      },
      "border": {
        "$value": "{semantic.color.boundary.default}",
        "$type": "color"
      },
      "radius": {
        "$value": "{semantic.radius.tile}",
        "$type": "dimension"
      },
      "min-height": {
        "$value": "{semantic.size.target}",
        "$type": "dimension"
      }
    },
    "progress-dots": {
      "done": {
        "$value": "{semantic.color.state.mastered}",
        "$type": "color"
      },
      "current": {
        "$value": "{semantic.color.action.primary}",
        "$type": "color"
      },
      "pending": {
        "$value": "{semantic.color.boundary.default}",
        "$type": "color"
      }
    }
  }
}
